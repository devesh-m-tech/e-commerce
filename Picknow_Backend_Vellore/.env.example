# ============================================================
# SHRI DEEPAALAYA SILKS — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to source control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB — SEPARATE database from original client
MONGO_URI=NEEDS_CLIENT_INPUT
# Example: mongodb+srv://user:password@cluster.mongodb.net/shrideepaalaya_silks

# JWT
JWT_SECRET=NEEDS_CLIENT_INPUT
JWT_EXPIRY=7d

# Cloudinary — SEPARATE account / folder from original client
CLOUDINARY_CLOUD_NAME=NEEDS_CLIENT_INPUT
CLOUDINARY_API_KEY=NEEDS_CLIENT_INPUT
CLOUDINARY_API_SECRET=NEEDS_CLIENT_INPUT
CLOUDINARY_UPLOAD_FOLDER=shrideepaalaya-silks

# AWS S3 (if used for image storage)
AWS_ACCESS_KEY_ID=NEEDS_CLIENT_INPUT
AWS_SECRET_ACCESS_KEY=NEEDS_CLIENT_INPUT
AWS_BUCKET_NAME=NEEDS_CLIENT_INPUT
AWS_REGION=ap-south-1

# Razorpay — SEPARATE credentials from original client
RAZORPAY_KEY_ID=NEEDS_CLIENT_INPUT
RAZORPAY_KEY_SECRET=NEEDS_CLIENT_INPUT

# Google OAuth
GOOGLE_CLIENT_ID=NEEDS_CLIENT_INPUT
GOOGLE_CLIENT_SECRET=NEEDS_CLIENT_INPUT
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email / SMTP (for order confirmations, OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=NEEDS_CLIENT_INPUT
SMTP_PASS=NEEDS_CLIENT_INPUT
SMTP_FROM_NAME="Shri Deepaalaya Silks"
SMTP_FROM_EMAIL=NEEDS_CLIENT_INPUT

# Twilio (SMS / WhatsApp alerts — optional)
TWILIO_ACCOUNT_SID=NEEDS_CLIENT_INPUT
TWILIO_AUTH_TOKEN=NEEDS_CLIENT_INPUT
TWILIO_PHONE_NUMBER=NEEDS_CLIENT_INPUT

# CORS — set to the new client's production domain
ALLOWED_ORIGINS=http://localhost:5173,https://www.shrideepaalayasilks.com

# Session secret
SESSION_SECRET=NEEDS_CLIENT_INPUT
