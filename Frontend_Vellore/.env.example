# ============================================================
# SHRI DEEPAALAYA SILKS — Frontend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to source control.
# ============================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# App name (used in SEO / meta tags)
VITE_APP_NAME="Shri Deepaalaya Silks"

# Google OAuth Client ID (if Google sign-in is used)
VITE_GOOGLE_CLIENT_ID=NEEDS_CLIENT_INPUT

# Razorpay Key ID (public key — safe to expose)
VITE_RAZORPAY_KEY_ID=NEEDS_CLIENT_INPUT
